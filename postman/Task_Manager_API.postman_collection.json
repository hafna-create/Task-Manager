            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"emma.johnson@example.com\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
                  "var j = pm.response.json(); if (j.token) { pm.collectionVariables.set(\"staff_token\", j.token); }"
